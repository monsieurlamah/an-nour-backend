# ---- Application ----
APP_NAME="e-Boutique API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Server ----
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Database (MySQL) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=business_flow_suite
DB_ECHO=false
# Optional full override (takes precedence over the MYSQL_* values above):
# DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/business_flow_suite?charset=utf8mb4

# ---- Security / JWT ----
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS (comma-separated) ----
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ---- Localisation ----
# Indicatif pays par défaut pour normaliser les numéros locaux (Guinée = 224).
DEFAULT_COUNTRY_CODE=224

# ---- Email (SMTP) ----
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
EMAIL=contact@example.com
EMAIL_PASS=changeme
EMAIL_FROM_NAME=e-Boutique

# ---- OTP (vérification e-mail) ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Seed: first super-admin (created by `poetry run seed`) ----
FIRST_SUPERADMIN_EMAIL=admin@bfs.local
FIRST_SUPERADMIN_PASSWORD=Admin@1234
FIRST_SUPERADMIN_FIRSTNAME=Super
FIRST_SUPERADMIN_LASTNAME=Admin
